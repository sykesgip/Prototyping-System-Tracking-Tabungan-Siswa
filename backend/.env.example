APP_PORT=8080
APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=tabungan_siswa

JWT_SECRET=supersecretkey_ganti_ini_di_production
JWT_EXPIRY_HOURS=24

# Dev only — untuk CORS saat frontend berjalan di port berbeda (npm run dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production (Railway): Go serve React dist secara langsung
# Tidak perlu diisi saat dev karena Vite proxy yang handle
# STATIC_DIR=/app/dist
